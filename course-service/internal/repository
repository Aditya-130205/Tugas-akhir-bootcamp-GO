package repository

import (
	"context"
	"database/sql"
	"errors"

	"course-service/internal/domain"
)

// CourseRepository berisi koneksi database
type CourseRepository struct {
	db *sql.DB
}

// NewCourseRepository adalah constructor (Dependency Injection)
func NewCourseRepository(db *sql.DB) *CourseRepository {
	return &CourseRepository{db: db}
}

// ReserveSeat mengamankan 1 kursi (Atomic Update untuk BR-01)
func (r *CourseRepository) ReserveSeat(ctx context.Context, courseID int) error {
	// Query ini langsung mengecek sisa kapasitas di dalam database.
	// Jauh lebih aman dari race condition dibanding melakukan SELECT lalu UPDATE di kode Go.
	query := `
		UPDATE courses 
		SET taken = taken + 1 
		WHERE id = $1 AND capacity - taken > 0 
		RETURNING id;
	`

	var id int
	err := r.db.QueryRowContext(ctx, query, courseID).Scan(&id)
	if err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			// Jika tidak ada baris yang di-update, berarti id tidak ada ATAU kuota habis
			return domain.ErrNoSeat
		}
		return err
	}

	return nil
}

// ReleaseSeat mengembalikan 1 kursi
func (r *CourseRepository) ReleaseSeat(ctx context.Context, courseID int) error {
	query := `
		UPDATE courses 
		SET taken = taken - 1 
		WHERE id = $1 AND taken > 0 
		RETURNING id;
	`

	var id int
	err := r.db.QueryRowContext(ctx, query, courseID).Scan(&id)
	if err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return domain.ErrCourseNotFound
		}
		return err
	}

	return nil
}
